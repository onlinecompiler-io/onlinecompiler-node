{
  "name": "onlinecompiler",
  "version": "0.8.0",
  "description": "Client for the OnlineCompiler.io code execution API: run and judge code in 46 languages in a sandbox, with tools for the Vercel AI SDK",
  "keywords": [
    "code execution",
    "online compiler",
    "compiler api",
    "judge0",
    "online judge",
    "sandbox",
    "onlinecompiler",
    "code judge",
    "webhooks",
    "signed receipts",
    "ai-sdk",
    "vercel ai sdk",
    "ai tools"
  ],
  "homepage": "https://onlinecompiler.io/docs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onlinecompiler-io/onlinecompiler-node.git"
  },
  "bugs": {
    "url": "https://github.com/onlinecompiler-io/onlinecompiler-node/issues"
  },
  "license": "MIT",
  "author": "RunCode Inc.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ai-sdk": {
      "types": "./dist/ai-sdk.d.ts",
      "default": "./dist/ai-sdk.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "ai-sdk": [
        "dist/ai-sdk.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsc",
    "test": "tsc && node --test test/*.test.js",
    "prepublishOnly": "npm test"
  },
  "peerDependencies": {
    "ai": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "ai": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "ai": "^7.0.163",
    "typescript": "^7.0.2"
  }
}
